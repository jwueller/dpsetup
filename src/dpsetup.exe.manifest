<?xml version="1.0" encoding="UTF-8" standalone="yes"?>
<assembly xmlns="urn:schemas-microsoft-com:asm.v1" manifestVersion="1.0">
  <!--
    Deliberately minimal. asInvoker: extraction into a folder the user can
    write (`dpsetup.exe <dir>`) needs no elevation and must not ask for it.
    Install mode (no argument) needs administrator rights and elevates
    itself with a runas relaunch. Nothing else belongs here: no dpiAware
    (windowless), no longPathAware (MAX_PATH buffers throughout), no
    activeCodePage (W APIs only). Wine has no UAC and ignores elevation.
  -->
  <trustInfo xmlns="urn:schemas-microsoft-com:asm.v3">
    <security>
      <requestedPrivileges>
        <requestedExecutionLevel level="asInvoker" uiAccess="false"/>
      </requestedPrivileges>
    </security>
  </trustInfo>
  <compatibility xmlns="urn:schemas-microsoft-com:compatibility.v1">
    <application>
      <!-- Windows 10 and 11 share this id; nothing older is supported -->
      <supportedOS Id="{8e0f7a12-bfb3-4fe8-b9a5-48fd50a15a9a}"/>
    </application>
  </compatibility>
</assembly>

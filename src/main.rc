#pragma code_page(65001) // UTF-8
#include <winresrc.h>
#include "meta.h"

#if PROJECT_PREVIEW
#define VERSIONINFO_FILEFLAGS_PRERELEASE    VS_FF_PRERELEASE
#else
#define VERSIONINFO_FILEFLAGS_PRERELEASE    0
#endif

#if _DEBUG
#define VERSIONINFO_FILEFLAGS_DEBUG         VS_FF_DEBUG
#else
#define VERSIONINFO_FILEFLAGS_DEBUG         0
#endif

#define VERSIONINFO_VERSION                 PROJECT_VERSION_MAJOR, \
                                            PROJECT_VERSION_MINOR, \
                                            PROJECT_VERSION_PATCH, \
                                            PROJECT_VERSION_TWEAK

VS_VERSION_INFO VERSIONINFO
    FILEVERSION     VERSIONINFO_VERSION
    PRODUCTVERSION  VERSIONINFO_VERSION
    FILEFLAGSMASK   VS_FFI_FILEFLAGSMASK
    FILEFLAGS       (VERSIONINFO_FILEFLAGS_PRERELEASE | VERSIONINFO_FILEFLAGS_DEBUG)
    FILEOS          VOS_NT_WINDOWS32
    FILETYPE        VFT_APP
    FILESUBTYPE     VFT_UNKNOWN
BEGIN
    BLOCK "StringFileInfo"
    BEGIN
        BLOCK "040904B0"
        BEGIN
            VALUE "CompanyName",        PROJECT_AUTHOR
            VALUE "LegalCopyright",     PROJECT_COPYRIGHT
            VALUE "ProductName",        PROJECT_NAME
            VALUE "ProductVersion",     PROJECT_VERSION
            VALUE "Comments",           PROJECT_NOTICE
            VALUE "FileVersion",        PROJECT_VERSION
            VALUE "FileDescription",    PROJECT_DESCRIPTION
            VALUE "InternalName",       PROJECT_MODULE
            VALUE "OriginalFilename",   PROJECT_MODULE ".exe"
        END
    END
    BLOCK "VarFileInfo"
    BEGIN
        VALUE "Translation", 0x0409, 0x04B0
    END
END

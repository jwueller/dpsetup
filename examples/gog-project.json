{
  "project": {
    "baseProductId": "",
    "clientId": "",
    "clientSecret": "",
    "version": "1.0",
    "installDirectory": "Example Game",
    "name": "Example Game",
    "platform": "windows",
    "scriptInterpreter": true,
    "dependencies": [],
    "products": [
      {
        "name": "Example Game",
        "productId": "",
        "depots": [
          {
            "name": "Common",
            "folder": "C:\\path\\to\\game\\files"
          }
        ],
        "setupSteps": [
          {
            "name": "DirectPlay",
            "install": {
              "action": "Execute",
              "arguments": {
                "executable": "{app}\\dpsetup\\dpsetup.exe",
                "workingDir": "{app}\\dpsetup",
                "runAsAdmin": true,
                "arguments": "",
                "conditions": [
                  "onlyOnce"
                ]
              }
            }
          },
          {
            "name": "Firewall exception",
            "install": {
              "action": "Execute",
              "arguments": {
                "executable": "{app}\\dpfirewall.cmd",
                "workingDir": "{app}",
                "runAsAdmin": true,
                "arguments": "allow \"{app}\\game.exe\"",
                "conditions": [
                  "onlyOnce"
                ]
              }
            },
            "uninstall": {
              "action": "Execute",
              "arguments": {
                "executable": "{app}\\dpfirewall.cmd",
                "workingDir": "{app}",
                "runAsAdmin": true,
                "arguments": "revoke \"{app}\\game.exe\""
              }
            }
          }
        ],
        "tasks": [
          {
            "type": "FileTask",
            "name": "Example Game",
            "category": "game",
            "path": "game.exe",
            "isPrimary": true
          }
        ],
        "supportDepots": []
      }
    ]
  }
}
